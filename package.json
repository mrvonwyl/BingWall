{
  "name": "bingwall",
  "version": "0.2.0",
  "description": "A small, installable Windows desktop app that replaces the official Bing Wallpaper app.",
  "type": "module",
  "main": "dist/main/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:ts": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "start": "npm run build:ts && electron .",
    "build": "npm run build:ts && electron-builder",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.elysion.bingwall",
    "productName": "BingWall",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "mrvonwyl",
      "repo": "BingWall"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BingWall"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.5"
  }
}
